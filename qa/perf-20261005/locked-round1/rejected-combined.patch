diff --git a/sudoku/queuedcandidates.bend b/sudoku/queuedcandidates.bend
index b757bc9..4718615 100644
--- a/sudoku/queuedcandidates.bend
+++ b/sudoku/queuedcandidates.bend
@@ -45,8 +45,37 @@ def encode_go(+n: Nat, +pos: U32, b: Array<U32>) -> Array<U32>:
     case 1n+k:
       encode_go(k, (pos + 1 : U32), encoded(pos, Array.get(U32, b, pos)))
 
+# Full encoding starts with zero flags and visits each cell exactly once.
+# A nonurgent cell therefore needs no read or write of its flag word. Keep
+# encoded/encode_go unchanged for callers that supply existing flag words.
+def encode_fresh_flag(+urgent: Bool, b: Array<U32>, +pos: U32) -> Array<U32>:
+  match urgent:
+    case True{}:
+      flag(b, pos, True{})
+    case False{}:
+      b
+
+def encode_fresh_mask(+pos: U32, r: Array<U32> & U32) -> Array<U32>:
+  (b, +mask) = r
+  encode_fresh_flag(zero_or_single(mask), Array.set(U32, b, pos, mask), pos)
+
+def encode_fresh_cell(+pos: U32, r: Array<U32> & U32) -> Array<U32>:
+  (b, digit) = r
+  match digit:
+    case 0:
+      encode_fresh_mask(pos, C.cached_at(b, pos))
+    case d:
+      Array.set(U32, b, pos, U32.shln(d, 10n))
+
+def encode_fresh_go(+n: Nat, +pos: U32, b: Array<U32>) -> Array<U32>:
+  match n:
+    case 0n:
+      b
+    case 1n+k:
+      encode_fresh_go(k, (pos + 1 : U32), encode_fresh_cell(pos, Array.get(U32, b, pos)))
+
 def encode(b: Array<U32>) -> Array<U32>:
-  encode_go(81n, 0, Array.set(U32, Array.set(U32, Array.set(U32, b, 109, 0), 110, 0), 111, 0))
+  encode_fresh_go(81n, 0, Array.set(U32, Array.set(U32, Array.set(U32, b, 109, 0), 110, 0), 111, 0))
 
 def decoded(+pos: U32, r: Array<U32> & U32) -> Array<U32>:
   (b, word) = r
diff --git a/sudoku/ratingindex.bend b/sudoku/ratingindex.bend
index 7e26d91..3db8fc9 100644
--- a/sudoku/ratingindex.bend
+++ b/sudoku/ratingindex.bend
@@ -125,6 +125,27 @@ def hidden(+n: Nat, +index: U32, r: Array<U32> & D.Action) -> Array<U32> & D.Act
     case 1n+k Tuple{cache, D.NoAction{}}:
       hidden(k, (index + 1 : U32), hidden_cell(index, Array.get(U32, cache, index)))
 
+# Continue checking every entry for missing support while retaining the first
+# hidden single. Missing support has priority over any placement action.
+def missing_hidden_found(+bad: Bool, r: Array<U32> & D.Action) -> Array<U32> & Bool & D.Action:
+  (cache, found) = r
+  (cache, (bad, found))
+
+def missing_hidden_entry(+index: U32, +bad: Bool, r: Array<U32> & U32, action: D.Action) -> Array<U32> & Bool & D.Action:
+  match r action:
+    case Tuple{cache, +word} D.NoAction{}:
+      missing_hidden_found(bad || U32.is_eq(word, 0), hidden_cell(index, (cache, word)))
+    case Tuple{cache, word} other:
+      (cache, (bad || U32.is_eq(word, 0), other))
+
+def missing_hidden(+n: Nat, +index: U32, r: Array<U32> & Bool & D.Action) -> Array<U32> & Bool & D.Action:
+  match n:
+    case 0n:
+      r
+    case 1n+k:
+      (cache, (bad, action)) = r
+      missing_hidden(k, (index + 1 : U32), missing_hidden_entry(index, bad, Array.get(U32, cache, index), action))
+
